# Generated by npm — let npm own its format. Prettier reformatting it only
# creates churn every time the lockfile is regenerated.
package-lock.json

# Generated output — never hand-edited, never worth formatting.
node_modules/
playwright-report/
allure-report/
allure-results-*/
test-results/
.test-history/

# Agent-facing files whose format is dictated by validate-skills.mjs, not by
# prettier. Prettier rewrites `*not*` -> `_not_` in headings and explodes
# single-line frontmatter arrays across lines; both break the validator, which
# parses frontmatter as `key: value` lines and looks for the literal
# "When *not* to use this skill" heading. Formatting these is not prettier's call.
.claude/
.github/prompts/
