# Playwright test automation environment variables
# Copy to .env (git-ignored) or export in your shell / CI secret store.
# Never commit real credentials.

# Application base URL
BASE_URL=https://your-app.example.com

# SSO / login credentials
APP_USER=
APP_PASSWORD=

# Additional role credentials (add per project slice)
# APP_ADMIN_USER=
# APP_ADMIN_PASSWORD=

# SauceLabs credentials (if using Sauce execution)
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=

# Allure report — set to true to auto-open report after each run
OPEN_ALLURE_REPORT=false

# SauceLabs execution flag
SAUCE=
